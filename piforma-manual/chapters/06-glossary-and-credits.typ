#glossary-entry("Apple Desktop Bus (ADB)",[#text("The connection system used by the original vintage keyboard before its Bluetooth conversion.")])
#glossary-entry("AtEase",[#text("The PiForma’s folder-like launcher for opening configured programs.")])
#glossary-entry("Bluetooth LE",[#text("Bluetooth Low Energy, the wireless connection used by the converted keyboard.")])
#glossary-entry("Chime selector",[#text("The rear dial that chooses a startup sound; some settings are silent.")])
#glossary-entry("Clippy",[#text("The assistant at the lower-right corner of the desktop. Type a question in its Chat with Clippy window; check its suggestions against the actual setup.")])
#glossary-entry("Composite video",[#text("The video signal accepted by the rear RCA input, used to show an external source on the PiForma screen. The jack carries video only, not audio.")])
#glossary-entry("Control Strip",[#text("The small program-launching and window-focus strip supplied by ControlStrip Simulator.")])
#glossary-entry("Desktop",[#text("The working screen with its background, launchers, menu bar, and application windows.")])
#glossary-entry("Docs Viewer",[#text("Macintosh PiForma Docs Viewer, the program for reading the project’s hardware, software and maintenance documents, with an offline snapshot. It is separate from About This PiForma.")])
#glossary-entry("EmulationStation",[#text("The game-list menu of RetroPie, opened from AtEase. It is a separate application from the games it starts.")])
#glossary-entry("Emulator",[#text("A program that imitates another computer or games system so compatible software can run.")])
#glossary-entry("Full-screen application",[#text("A program occupying the display, often covering the normal desktop menus.")])
#glossary-entry("GPIO",[#text("General-purpose input/output pins on the Raspberry Pi, used for controls in this build. Appendix A uses BCM pin numbering.")])
#glossary-entry("HDMI",[#text("The digital video connection that carries the Raspberry Pi’s picture to the PiForma screen. Select HDMI on the rear source selector to see the Pi.")])
#glossary-entry("microSD",[#text("The small storage card containing the PiForma’s operating system and saved files.")])
#glossary-entry("PiForma Panel",[#text("The program that supplies the menu bar across the top of the screen, including the Special menu with Shut Down and Sleep Display.")])
#glossary-entry("Qi charging",[#text("Wireless charging using an aligned transmitter and receiver.")])
#glossary-entry("Raspberry Pi",[#text("The small computer board inside the PiForma case.")])
#glossary-entry("Raspberry Pi OS",[#text("The operating system documented beneath the PiForma’s Macintosh-inspired desktop.")])
#glossary-entry("RetroPie",[#text("The games/emulation environment, opened through EmulationStation in this setup.")])
#glossary-entry("Save state",[#text("An emulator’s snapshot of a game in progress. It is a different facility from the game’s own save.")])
#glossary-entry("Screen saver",[#text("An animation that fills the screen. On the PiForma, the Flying Toasters are a screen saver you start yourself; nothing starts on its own when the computer is idle. Hold the Apple logo for about six seconds to stop it.")])
#glossary-entry("USB hub",[#text("An accessory that provides several USB connections from one computer port.")])
#glossary-entry("Wi-Fi",[#text("The wireless network connection, managed by the operating system’s network tools. Bluetooth and the mouse’s USB wireless receiver do not provide it.")])
